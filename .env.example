# copy this to .env and fill in the values

# the only targets the runner is allowed to touch, as scheme://host:port.
# the target of a run has to match one of these exactly.
ALLOWED_TARGETS=http://localhost:3000

# deepseek api key, required unless MOCK_AGENT=1 or the run is started with --only
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# request limits for one run
MAX_REQUESTS_PER_RUN=120
REQUEST_DELAY_MS=200
REQUEST_TIMEOUT=10

# set to 1 to skip the api completely and use the built in fallback plan
MOCK_AGENT=0

# endpoints the checks use, so the tool is not hardcoded to one app
LOGIN_PATH=/rest/user/login
SEARCH_PATH=/rest/products/search
